rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Issue #12: 管理者許可リスト。src/auth.py の is_admin_email() と同じ
    // 判定基準（admins/{email小文字} の存在チェックのみ）。
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // admins コレクション: 一覧(list)は誰にも許可しない（管理者メールアドレスの
    // 列挙を防ぐため）。自分自身の1件だけ get を許可し、フロントの isAdmin 判定に使う。
    // 書き込みは scripts/seed_admins.py（Admin SDK、ルールをバイパス）からのみ。
    match /admins/{adminEmail} {
      allow get: if request.auth != null
                 && request.auth.token.email.lower() == adminEmail;
      allow list, write: if false;
    }

    // 受講生: 閲覧はリンク共有運用のため無認証で維持。更新（辞退切替）は管理者のみ。
    match /students/{studentId} {
      allow read: if true;
      // ステータス更新のみ許可（status と last_updated フィールドのみ変更可能）
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'last_updated']);
      allow create, delete: if false;  // 作成・削除は禁止
    }

    // 提出ファイル: 閲覧のみ（リンク共有運用）。バックエンドはAdmin SDKでルールをバイパスする。
    match /submissions/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // 提出ファイル(collectionGroupクエリ用): 受講生詳細ページの提出履歴表示は
    // collectionGroup('files')で全クラス・全課題を横断検索する。上のmatch
    // /submissions/{document=**}は起点パスが固定された「path-specific」ルールのため、
    // Firestoreの仕様上collectionGroupクエリには適用されない（2026-08-27のIssue #12
    // 対応でこの点が見落とされ、以降「提出履歴」機能がMissing or insufficient
    // permissionsで機能しなくなっていた）。
    //
    // 🚨 codex review指摘・実機検証済みの既知の制約: このルールは"files"という名前を持つ
    // 任意階層のサブコレクション全てにread権限を与えてしまい、submissions配下に限定
    // できない。以下2つの代替案を実機で試したが、いずれもFirestoreの仕様上機能しなかった:
    //   1. match /submissions/{class}/tasks/{task}/files/{fileId}のように祖先パスの
    //      深さを固定する → collectionGroupクエリのlist操作自体が拒否される
    //      （祖先パスが可変長ワイルドカード{path=**}でないと、Firestoreはcollection
    //      group全体のlist権限を評価できない仕様のため）
    //   2. list権限だけ広く許可し、get権限をsubmissions配下に限定する → list実行時は
    //      個々のドキュメントのget権限が再評価されず、クエリにマッチした全ドキュメント
    //      がそのまま返ってしまう（get限定の効果がない）
    // 結論: 現時点で"files"という名前のサブコレクションはsubmissions配下にしか存在しない
    // ため実害はないが、将来別の場所に"files"という名前のサブコレクションを追加する場合は
    // このルールが意図せず公開範囲を広げる。追加する際は、このルールをリネーム等で
    // 無害化してから新コレクションを追加すること。
    match /{path=**}/files/{fileId} {
      allow read: if true;
      allow write: if false;
    }

    // 🚨 default-deny。
    // 旧ルールの `match /{document=**} { allow read: if true; }` は Firestore の
    // permissive union（いずれか1つのmatchがallowなら通る）により、admins コレクション
    // まで無条件公開してしまうトラップだった（Issue #12で発見）。
    // 新規コレクションをDashboardから読む場合は、上に明示matchを追加すること。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
